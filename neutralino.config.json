{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "edu.microprocesadores.sim8085",
  "version": "1.6.0",
  "defaultMode": "window",
  "port": 38085,
  "documentRoot": "/web/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "filesystem.*",
    "storage.*",
    "events.*"
  ],
  "modes": {
    "window": {
      "title": "Simulador Moderno Intel 8085 (Desktop Native WebView2)",
      "width": 1360,
      "height": 880,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "simulador-8085",
    "resourcesPath": "/web/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/web/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
